<UserControl x:Class="GameShelf.Controls.SearchBox"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="36">
    <Border x:Name="Frame" Background="#1d1a17" BorderBrush="#3a352f" BorderThickness="1" CornerRadius="18">
        <Grid>
            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#7a7367"
                       VerticalAlignment="Center" HorizontalAlignment="Left" Margin="14,0,0,0"/>
            <TextBlock x:Name="Placeholder" Text="Search games or genres" Foreground="#6f675b" FontSize="13.5"
                       VerticalAlignment="Center" Margin="40,0,0,0" IsHitTestVisible="False"/>
            <TextBox x:Name="Input" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="#d9b77a"
                     FontSize="14" VerticalContentAlignment="Center" Margin="38,0,34,0"
                     TextChanged="OnTextChanged" GotKeyboardFocus="OnFocusChanged" LostKeyboardFocus="OnFocusChanged"/>
            <Button x:Name="ClearButton" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                    Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Margin="0,0,6,0" Padding="8"
                    Visibility="Collapsed" ToolTip="Clear search" Click="OnClearClick"/>
        </Grid>
    </Border>
</UserControl>
