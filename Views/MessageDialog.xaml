<UserControl x:Class="GameShelf.Views.MessageDialog"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="460" MaxWidth="640" Background="#1b1b1b">
    <StackPanel Margin="30,28,30,26">
        <TextBlock x:Name="HeadingText" FontSize="21" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
        <TextBlock x:Name="BodyText" Foreground="#bdb6a8" FontSize="14" LineHeight="21" TextWrapping="Wrap" Margin="0,12,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
            <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Height="40" MinWidth="120"
                    Margin="0,0,10,0" IsCancel="True" Click="OnCancelClick"/>
            <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Height="40" MinWidth="130"
                    IsDefault="True" Click="OnConfirmClick"/>
        </StackPanel>
    </StackPanel>
</UserControl>
