<UserControl x:Class="GameShelf.Views.InputDialog"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="460" Background="#1b1b1b">
    <StackPanel Margin="30,28,30,26">
        <TextBlock x:Name="HeadingText" FontSize="21" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
        <Border Background="#1d1a17" BorderBrush="#3a352f" BorderThickness="1" CornerRadius="6" Margin="0,18,0,0">
            <TextBox x:Name="Input" MaxLength="30" Background="Transparent" BorderThickness="0" Foreground="White"
                     CaretBrush="#d9b77a" FontSize="15" Padding="12,9"/>
        </Border>
        <TextBlock x:Name="ErrorText" Foreground="#e0735f" FontSize="12.5" Margin="0,8,0,0" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Height="40" MinWidth="110" Margin="0,0,10,0"
                    IsCancel="True" Click="OnCancelClick"/>
            <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Height="40" MinWidth="120" IsDefault="True"
                    Click="OnConfirmClick"/>
        </StackPanel>
    </StackPanel>
</UserControl>
