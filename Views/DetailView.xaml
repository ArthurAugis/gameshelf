<UserControl x:Class="GameShelf.Views.DetailView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:GameShelf.Controls"
             Background="#121110" Focusable="True" PreviewKeyDown="OnPreviewKeyDown">
    <Grid ClipToBounds="True">
        <!-- Blurred hero artwork, fading into the background -->
        <Image x:Name="Backdrop" Stretch="UniformToFill" VerticalAlignment="Top" Height="440" Margin="-40,-40,-40,0" Opacity="0">
            <Image.Effect>
                <BlurEffect Radius="24"/>
            </Image.Effect>
        </Image>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#A0121110" Offset="0"/>
                    <GradientStop Color="#121110" Offset="0.7"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Margin="48,56,48,32" MaxWidth="1100">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Soft glow in the game's colour, centred behind the box. It spans both columns (WPF cuts an element to
                 its cell, and the glow is wider than the 340 px box column); -70 centres its 480 px on that column. -->
            <Ellipse x:Name="Glow" Grid.ColumnSpan="2" Width="480" Height="480" HorizontalAlignment="Left" VerticalAlignment="Center"
                     Margin="-70,0,0,0" Opacity="0.4" IsHitTestVisible="False"/>

            <!-- 3D box, added in code -->
            <Grid x:Name="Stage"/>

            <!-- The facts scroll when the window is too short for them -->
            <ScrollViewer x:Name="InfoScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="34,0,0,0">
              <Grid MinHeight="{Binding ViewportHeight, ElementName=InfoScroll}">
                <StackPanel VerticalAlignment="Center">
                <Image x:Name="LogoImage" MaxWidth="460" MaxHeight="120" HorizontalAlignment="Left" Visibility="Collapsed"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock x:Name="TitleText" FontSize="38" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>

                <TextBlock x:Name="MetaText" Foreground="#9a9183" FontSize="13.5" Margin="0,12,0,0" TextWrapping="Wrap"/>
                <WrapPanel x:Name="GenreChips" Margin="0,14,0,0"/>
                <TextBlock x:Name="DescriptionText" Foreground="#cfc8bb" FontSize="14.5" LineHeight="23" TextWrapping="Wrap"
                           MaxHeight="92" Margin="0,8,0,0"/>

                <!-- Key facts -->
                <Border BorderBrush="#33FFFFFF" BorderThickness="0,1" Margin="0,26,0,0" Padding="0,16">
                    <UniformGrid Columns="4">
                        <StackPanel>
                            <TextBlock Text="STATUS" Foreground="#7a7367" FontSize="10.5" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,1,7,0"/>
                                <TextBlock x:Name="StatusValue" Foreground="White" FontSize="15"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="STORAGE" Foreground="#7a7367" FontSize="10.5" FontWeight="SemiBold"/>
                            <TextBlock x:Name="StorageValue" Foreground="White" FontSize="15" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="PLAY TIME" Foreground="#7a7367" FontSize="10.5" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PlayTimeValue" Foreground="White" FontSize="15" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="LAST PLAYED" Foreground="#7a7367" FontSize="10.5" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LastPlayedValue" Foreground="White" FontSize="15" Margin="0,5,0,0"/>
                        </StackPanel>
                    </UniformGrid>
                </Border>

                <!-- Download progress, shown while the game installs -->
                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,24,0,0">
                    <Grid>
                        <TextBlock x:Name="ProgressText" Foreground="White" FontSize="14.5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ProgressDetail" Foreground="#9a9183" FontSize="13" HorizontalAlignment="Right"/>
                    </Grid>
                    <ProgressBar x:Name="InstallBar" Height="8" Margin="0,10,0,0" Minimum="0" Maximum="100"
                                 Background="#2a2622" Foreground="#4c9b3a" BorderThickness="0"/>
                    <ctl:SpeedGraph x:Name="SpeedChart" Height="72" Margin="0,12,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="PauseButton" Content="Pause" Style="{StaticResource SecondaryButton}" Height="36"
                                MinWidth="110" Margin="0,0,8,0" Click="OnPauseClick"/>
                        <Button Content="Cancel download" Style="{StaticResource LinkButton}"
                                Click="OnCancelInstallClick"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                    <Button x:Name="PlayButton" Content="Play" Style="{StaticResource PrimaryButton}" Height="46" MinWidth="170"
                            Margin="0,0,10,0" Click="OnPlayClick"/>
                    <Button x:Name="InstallButton" Content="Install" Style="{StaticResource PrimaryButton}" Background="#2d6fb3"
                            Height="46" MinWidth="170" Margin="0,0,10,0" Click="OnInstallClick"/>
                    <Button x:Name="UninstallButton" Content="Uninstall" Style="{StaticResource SecondaryButton}" Height="46"
                            Click="OnUninstallClick"/>
                </StackPanel>

                <!-- Personal status, rating and note -->
                <Grid Margin="0,22,0,0">
                    <WrapPanel x:Name="StatusChips" VerticalAlignment="Center"/>
                    <StackPanel x:Name="Stars" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
                <Border Background="#1d1a17" BorderBrush="#3a352f" BorderThickness="1" CornerRadius="6" Margin="0,2,0,0">
                    <Grid>
                        <TextBlock x:Name="CommentPlaceholder" Text="Add a note about this game" Foreground="#6f675b" FontSize="13.5"
                                   Margin="12,8,12,8" IsHitTestVisible="False"/>
                        <TextBox x:Name="CommentBox" Background="Transparent" BorderThickness="0" Foreground="White"
                                 CaretBrush="#d9b77a" FontSize="13.5" Padding="9,6" MaxLength="400" AcceptsReturn="False"
                                 TextChanged="OnCommentChanged" LostKeyboardFocus="OnCommentLostFocus"/>
                    </Grid>
                </Border>

                <WrapPanel x:Name="CollectionChips" Margin="0,16,0,0"/>

                <Button x:Name="EditButton" Content="Edit this game" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                        Margin="-8,14,0,0" Visibility="Collapsed" Click="OnEditClick"/>
                <Button x:Name="HideButton" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="-8,14,0,0"
                        Click="OnHideClick"/>
                </StackPanel>
              </Grid>
            </ScrollViewer>
        </Grid>

        <Button Content="Back" ToolTip="Esc" Style="{StaticResource LinkButton}" FontSize="14" Foreground="#cfc8bb"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="22,16,0,0" Padding="12,6" Click="OnBackClick"/>
    </Grid>
</UserControl>
