<Window x:Class="GameShelf.Views.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:GameShelf.Controls"
        Title="GameShelf" Height="800" Width="1280" Background="#111" Icon="/Assets/logo.png"
        PreviewKeyDown="OnPreviewKeyDown" PreviewMouseMove="OnPreviewMouseMove">
    <Grid>
        <!-- Header and shelf -->
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="58" Padding="26,0" BorderThickness="0,0,0,1" BorderBrush="#33FFFFFF">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F2120F0C" Offset="0"/>
                        <GradientStop Color="#D8120F0C" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/logo.png" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="GameShelf" FontFamily="Georgia" FontSize="23" Foreground="#d9b77a" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Foreground="#8a8378" FontSize="12.5" VerticalAlignment="Center" Margin="20,3,0,0"/>
                    </StackPanel>

                    <!-- Search and filters -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="24,0">
                        <ctl:SearchBox x:Name="Search" Width="340"/>
                        <Button x:Name="FiltersButton" Content="Filters" Style="{StaticResource SecondaryButton}" Height="36"
                                Padding="16,0" Margin="10,0,0,0" Click="OnFiltersClick"/>
                        <Popup x:Name="FilterPopup" PlacementTarget="{Binding ElementName=FiltersButton}" Placement="Bottom"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Closed="OnFilterPopupClosed">
                            <ctl:FilterPanel x:Name="Filters" Margin="14,6,14,22"/>
                        </Popup>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ExactButton" Content="Enable exact library" Visibility="Collapsed" Margin="0,0,22,0"
                                Style="{StaticResource SecondaryButton}" Height="30" FontSize="12.5"
                                Foreground="#d9b77a" BorderBrush="#99d9b77a" Click="OnExactLibraryClick"/>
                        <CheckBox x:Name="ShowHiddenToggle" Visibility="Collapsed" Foreground="#a39a8a" FontSize="12.5"
                                  VerticalAlignment="Center" Margin="0,0,22,0" Click="OnShowHiddenClick"/>
                        <Button x:Name="AddGameButton" Content="Add a game" Margin="0,0,10,0"
                                Style="{StaticResource SecondaryButton}" Height="30" FontSize="12.5" Click="OnAddGameClick"/>
                        <Button x:Name="EpicButton" Content="Epic library" Visibility="Collapsed" Margin="0,0,10,0"
                                Style="{StaticResource SecondaryButton}" Height="30" FontSize="12.5"
                                Foreground="#d9b77a" BorderBrush="#99d9b77a" Click="OnEpicClick"/>
                        <Button x:Name="GameUpdatesButton" Content="Updates" Visibility="Collapsed" Margin="0,0,10,0"
                                Style="{StaticResource SecondaryButton}" Height="30" FontSize="12.5"
                                Foreground="#d9b77a" BorderBrush="#99d9b77a" Click="OnGameUpdatesClick"/>
                        <Button x:Name="UpdateButton" Visibility="Collapsed" Style="{StaticResource SecondaryButton}" Height="30"
                                FontSize="12.5" Margin="0,0,10,0" Foreground="#d9b77a" BorderBrush="#99d9b77a"
                                Click="OnUpdateClick"/>
                        <Button x:Name="LanguageButton" Style="{StaticResource SecondaryButton}" Height="30" FontSize="12.5"
                                Padding="12,0" Margin="0,0,22,0" ToolTip="Language" Click="OnLanguageClick"/>
                        <Popup x:Name="LanguagePopup" PlacementTarget="{Binding ElementName=LanguageButton}" Placement="Bottom"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Closed="OnLanguagePopupClosed">
                            <Border Background="#F5181510" BorderBrush="#66d9b77a" BorderThickness="1" CornerRadius="10"
                                    Padding="14,12,14,6" Margin="14,6,14,22">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.55"/>
                                </Border.Effect>
                                <StackPanel x:Name="LanguageChips"/>
                            </Border>
                        </Popup>
                        <TextBlock Text="SHELF" Foreground="#6f675b" FontSize="10.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel x:Name="SkinChips" Orientation="Horizontal" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- Collections: click to filter, drop a game on one to add it -->
            <Border DockPanel.Dock="Top" Padding="26,9,26,3" Background="#E6120F0C" BorderThickness="0,0,0,1"
                    BorderBrush="#22FFFFFF">
                <WrapPanel x:Name="CollectionBar"/>
            </Border>
            <ScrollViewer x:Name="ShelfScroll" VerticalScrollBarVisibility="Auto" SizeChanged="OnShelfSizeChanged">
                <StackPanel x:Name="ShelfRows" Margin="40,30,40,30"/>
            </ScrollViewer>
        </DockPanel>

        <!-- Name of the game chosen with the keyboard or the controller -->
        <Border x:Name="FocusBar" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,26" Padding="22,10"
                CornerRadius="8" Background="#EE181510" BorderBrush="#99d9b77a" BorderThickness="1"
                Visibility="Collapsed" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="FocusTitle" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock x:Name="FocusHint" Foreground="#8a8378" FontSize="12.5" Margin="20,3,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- The page of a game, over the shelf -->
        <Grid x:Name="DetailHost" Visibility="Collapsed"/>

        <!-- Dialogs (confirmations, install choice, input, sign-in), over the shelf and the game page -->
        <Grid x:Name="DialogLayer" Visibility="Collapsed"/>

        <!-- Loading screen, shown until the library and the covers are ready -->
        <Border x:Name="Splash" Background="#141210">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">
                <Image Source="/Assets/logo.png" Width="110" Height="110" Margin="0,0,0,14" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="GameShelf" FontFamily="Georgia" FontSize="44" Foreground="#d9b77a" HorizontalAlignment="Center"/>
                <TextBlock x:Name="SplashText" Foreground="#bbb" FontSize="14" HorizontalAlignment="Center" Margin="0,22,0,12"
                           TextWrapping="Wrap" TextAlignment="Center"/>
                <ProgressBar x:Name="SplashBar" Height="6" Background="#2a2622" Foreground="#d9b77a" BorderThickness="0" IsIndeterminate="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
